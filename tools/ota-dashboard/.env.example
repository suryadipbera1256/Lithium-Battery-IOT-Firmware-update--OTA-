# =========================================================
# Local Docker only. COPY TO .env AND FILL IN.
# .env is git-ignored (root .gitignore: `.env` and `.env.*`).
#
# These reach boto3's default credential chain ONLY when secrets.toml has
# [aws].access_key_id and [aws].secret_access_key both set to "".
# Non-empty keys in secrets.toml take precedence and these are ignored.
# =========================================================

AWS_ACCESS_KEY_ID=AKIAxxxxxxxxxxxxxxxx
AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Only for temporary credentials (STS AssumeRole / SSO). Leave blank for a
# long-lived IAM user. An expired token here fails with a confusing
# "InvalidClientTokenId" rather than an obvious expiry message.
AWS_SESSION_TOKEN=

# Informational: the effective region always comes from [aws].region in
# secrets.toml, because core/aws.py passes region_name explicitly.
AWS_REGION=ap-south-1
