{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PullDashboardImageOnly",
      "Effect": "Allow",
      "Action": [
        "ecr:BatchGetImage",
        "ecr:GetDownloadUrlForLayer",
        "ecr:BatchCheckLayerAvailability"
      ],
      "Resource": "arn:aws:ecr:ap-south-1:441464447047:repository/as-ota-dashboard"
    },
    {
      "Sid": "EcrAuthToken",
      "Effect": "Allow",
      "Action": "ecr:GetAuthorizationToken",
      "Resource": "*"
    },
    {
      "Sid": "InjectSecretsTomlAtBoot",
      "Effect": "Allow",
      "Action": "secretsmanager:GetSecretValue",
      "Resource": "arn:aws:secretsmanager:ap-south-1:441464447047:secret:as-ota-dashboard/secrets-toml-*"
    },
    {
      "Sid": "DecryptSecretIfCmkEncrypted",
      "Effect": "Allow",
      "Action": "kms:Decrypt",
      "Resource": "arn:aws:kms:ap-south-1:441464447047:key/*",
      "Condition": {
        "StringEquals": {
          "kms:ViaService": "secretsmanager.ap-south-1.amazonaws.com"
        }
      }
    },
    {
      "Sid": "ShipLogsToOneGroup",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:ap-south-1:441464447047:log-group:/ecs/as-ota-dashboard:*"
    }
  ]
}