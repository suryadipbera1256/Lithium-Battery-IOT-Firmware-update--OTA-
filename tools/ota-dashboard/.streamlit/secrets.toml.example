# =========================================================
# COPY TO .streamlit/secrets.toml AND FILL IN.
# secrets.toml is git-ignored. Never commit real values.
# =========================================================

[auth]
# Two roles. operator = can CreateJob. viewer = read fleet + telemetry only.
operator_password = "change-me-operator"
viewer_password   = "change-me-viewer"
max_attempts      = 5          # lockout threshold per browser session

[aws]
region = "ap-south-1"
# OPTION A (preferred): leave keys blank and use the default credential chain
#   (env vars / ~/.aws/credentials / SSO / EC2-ECS role).
# OPTION B: explicit keys for a least-privilege dashboard IAM user.
#   See iam/dashboard-operator-policy.json
access_key_id     = ""
secret_access_key = ""
session_token     = ""
profile           = ""         # named profile; ignored if keys are set

[iot]
# ATS data endpoint: aws iot describe-endpoint --endpoint-type iot:Data-ATS
endpoint       = "xxxxxxxxxxxxxx-ats.iot.ap-south-1.amazonaws.com"
# Matches src/main.cpp: snprintf(topicBuf, ..., "bms/data/%s/telemetry", THING_NAME)
telemetry_topic_template = "bms/data/{thing}/telemetry"
thing_group    = ""            # optional: scope fleet discovery to one group
thing_type     = ""            # optional: scope fleet discovery to one type
job_id_prefix  = "as-ota"
# REQUIRED for OTA to work at all. Role AWS IoT assumes to SIGN the S3 URL in
# ${aws:iot:s3-presigned-url:...}. Without it the placeholder is delivered
# unexpanded and every device fails at AT+QHTTPGET with HTTP 403.
# Create it from iam/iot-presign-role.json.
presign_role_arn    = "arn:aws:iam::<ACCOUNT_ID>:role/AsOtaIotPresignRole"
presign_expires_sec = 3600     # 60-3600; signed when the device fetches the doc

[gmaps]
# OPTIONAL — Map Console tile provider. components/map_console.py reads
# st.secrets["gmaps"]["api_key"]; with it absent the map falls back to
# Carto/OpenStreetMap, which needs no key and works fine.
# A Maps key is billable and visible in the browser: restrict it by API
# (Maps Tiles/Static) AND by referrer/IP in the Google Cloud console.
api_key = ""

[s3]
# One bucket for every version. Bucket-per-version (as-ota-firmware-1-0-2) is
# retired -- it multiplied IAM scope and broke the presign policy per release.
bucket          = "as-ota-firmware"
firmware_prefix = "firmwares/"   # -> firmwares/firmware_v1_0_5.bin
jobs_prefix     = "jobs/"        # -> jobs/ota_job_v1_0_5.json  (audit archive)

[ota]
# partitions_ota.csv -> app0/app1 size 0x1E0000. Hard ceiling for any image.
app_slot_bytes    = 1966080
# EC200U_AWS_OTA.h: URC read buffer is 1536 B; leave room for the QMTRECV prefix.
urc_budget_bytes  = 1400
default_min_csq   = 12         # EC200U AT+CSQ RSSI units (0-31, 99 = unknown)
default_min_kbps  = 40
default_max_per_minute = 5     # staged rollout, never a fleet-wide blast
job_timeout_minutes    = 30
poll_ttl_seconds       = 10
fleet_ttl_seconds      = 300
