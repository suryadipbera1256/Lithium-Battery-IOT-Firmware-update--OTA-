# ==========================================================
# AS AI — Battery Fleet Firmware + OTA Dashboard
#
# Repository layout this protects:
#   /                       PlatformIO C++ firmware (ESP32 + EC200U-CN)
#   /certs/                 per-device AWS mTLS material
#   /scripts/               provisioning helpers (pyserial / dotenv)
#   /tools/ota-dashboard/   isolated Python + Streamlit workspace
#
# THIS FILE IS THE SINGLE SOURCE OF TRUTH. tools/ota-dashboard/.gitignore is
# deliberately reduced to secret rules only — duplicated rules in two files
# drift, and a rule that silently stopped matching is how generated IAM policies
# carrying a live account ID ended up committed once already.
#
# Two habits worth keeping:
#   * verify, do not assume:  git check-ignore -v <path>
#   * .gitignore does NOT untrack an already-tracked file. If something is
#     committed that should not be:  git rm -r --cached <path>
# ==========================================================


# ----------------------------------------------------------
# 1. CREDENTIALS & SECRETS   (CRITICAL — never relax)
# ----------------------------------------------------------
# Rules here are intentionally redundant (exact path AND recursive glob). One
# stray copy of a private key or secrets.toml is a fleet-wide compromise, and
# the cost of an extra pattern is nothing.

# Environment files, every variant (.env.local, .env.production, .env.mac …)
.env
.env.*
!.env.example

# X.509 material for AWS IoT mTLS — anywhere in the tree, not just certs/.
*.pem
*.key
*.crt
*.der
*.p12
*.pfx
*.jks

# Whole certs/ payload. The directory is intentionally empty on a fresh clone;
# `mkdir -p certs` before running scripts/factory_flash.py.
certs/*
!certs/.gitkeep
!certs/README*

# Streamlit secrets: real values only. The .example template must still ship.
secrets.toml
**/secrets.toml
.streamlit/secrets.toml
tools/ota-dashboard/.streamlit/secrets.toml
!**/secrets.toml.example

# Cloud credential caches some tooling drops in-tree
.aws/
*.credentials
*.pkcs12

# Rendered, apply-ready IAM policies (iam/render_policies.py output). Generated,
# and they embed a concrete ACCOUNT ID — shipping them lets a clone in a
# DIFFERENT account apply policies referencing resources it does not own. Those
# attach without error and then silently match nothing.
tools/ota-dashboard/iam/out/
iam/out/


# ----------------------------------------------------------
# 2. FIRMWARE BUILD OUTPUT (PlatformIO / ESP32)
# ----------------------------------------------------------
.pio/
.pioenvs/
.piolibdeps/
lib/*/examples/
lib/*/test/

# Compiled images and link artefacts. Firmware is distributed through
# s3://<bucket>/firmwares/, not git. Use `git add -f` to pin one deliberately.
*.bin
*.elf
*.hex
*.map
*.a
*.o
*.d
*.su

# Generated toolchain metadata — absolute, machine-local paths inside.
compile_commands.json
.clangd/
.cache/

# ESP-IDF, if the project ever moves off the Arduino framework
sdkconfig
sdkconfig.old
managed_components/
dependencies.lock


# ----------------------------------------------------------
# 3. PYTHON  (dashboard + provisioning scripts)
# ----------------------------------------------------------
# TWO separate virtualenvs by design: the root one belongs to PlatformIO, the
# dashboard has its own. Neither is ever committed.
.venv/
venv/
env/
ENV/
tools/**/.venv/
tools/ota-dashboard/.venv/

__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
pip-log.txt
pip-delete-this-directory.txt

# Test / lint / type-check caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
coverage.xml
.ipynb_checkpoints/


# ----------------------------------------------------------
# 4. EDITORS & IDE
# ----------------------------------------------------------
# Ship the two files that make a fresh clone build correctly; ignore the rest.
# c_cpp_properties.json and launch.json embed absolute local toolchain paths and
# differ per machine — committing them breaks the next person's IntelliSense.
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.code-workspace
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# Claude Code: machine-local overrides only. A shared .claude/settings.json
# stays tracked so team-wide hooks and permissions travel with the repo.
.claude/settings.local.json


# ----------------------------------------------------------
# 5. LOGS, CAPTURES & SCRATCH
# ----------------------------------------------------------
*.log
logs/
*.tmp
*.bak
*.orig
*.rej
scratch/
tmp/

# Serial-monitor and modem AT captures. These embed IMEI, ICCID and complete
# pre-signed OTA URLs — operational data, not source.
*.cap
monitor_*.txt
at_capture*.txt


# ----------------------------------------------------------
# 6. OS GENERATED
# ----------------------------------------------------------
# macOS entries matter now that the toolchain is moving to a Mac: .DS_Store is
# written into every directory Finder opens.
.DS_Store
.DS_Store?
._*
.AppleDouble
.LSOverride
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
